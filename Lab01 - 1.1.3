   "outputs": [],
   "source": [
    "import numpy as np \n",
    "import pandas as pd\n",
    "from scipy import stats"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "f77600f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "wine_data = pd.read_csv(\"winequality-red.csv\") "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f559d200",
   "metadata": {},
   "outputs": [],
   "source": [
    "wine_data = wine_data[\n",
    "    [\"alcohol\", \"volatile acidity\", \"sulphates\", \"pH\", \"quality\"]\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "2b08db18",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   alcohol  volatile acidity  sulphates    pH  quality\n",
      "0      9.4              0.70       0.56  3.51        5\n",
      "1      9.8              0.88       0.68  3.20        5\n",
      "2      9.8              0.76       0.65  3.26        5\n",
      "3      9.8              0.28       0.58  3.16        6\n",
      "4      9.4              0.70       0.56  3.51        5\n"
     ]
    }
   ],
   "source": [
    "print(wine_data.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "d6ab4415",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(1599, 5)"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "wine_data.dtypes \n",
    "wine_data.shape "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "06ce3c08",
   "metadata": {},
   "outputs": [],
   "source": [
    "target_column = \"alcohol\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "248edd01",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Tính giá trị trung bình (Mean)\n",
    "data_mean = np.mean(wine_data[target_column])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "f934f8e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Tính giá trị trung vị (Median)\n",
    "data_median = np.median(wine_data[target_column])\n",
    "# 3. Tính giá trị yếu vị / yếu tố xuất hiện nhiều nhất (Mode)\n",
    "data_mode = stats.mode(wine_data[target_column], keepdims=True).mode[0]\n",
    "\n",
    "# 4. Tính phương sai (Variance)\n",
    "data_variance = np.var(wine_data[target_column])\n",
    "\n",
    "# 5. Tính độ lệch chuẩn (Standard Deviation)\n",
    "data_sd = np.std(wine_data[target_column])\n",
    "\n",
    "# 6. Tính giá trị lớn nhất (Max) và nhỏ nhất (Min)\n",
    "data_max = np.max(wine_data[target_column])\n",
    "data_min = np.min(wine_data[target_column])\n",
    "\n",
    "# 7. Tính bách phân vị thứ 60 (60th percentile)\n",
    "data_percentile = np.percentile(wine_data[target_column], 60)\n",
    "\n",
    "# 8. Tính tứ phân vị thứ 3 / mức 75% (Quartiles)\n",
    "data_quartile = np.quantile(wine_data[target_column], 0.75)\n",
    "\n",
    "# 9. Tính khoảng biến thiên tứ phân vị (IQR)\n",
    "data_IQR = stats.iqr(wine_data[target_column])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "fdd5a0ec",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Thống kê mô tả cho cột [alcohol] ---\n",
      "Mean (Trung bình): 10.42\n",
